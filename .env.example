# ---------------------------------------------------------------- Google OAuth
# Optional. The site builds and runs without these — the workspace shows a
# setup panel instead of a sign-in button until they are set.
#
# How to obtain them:
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create Credentials -> OAuth client ID -> Web application
#   3. Authorised JavaScript origins:
#        http://localhost:3000
#        https://<your-vercel-domain>
#   4. Authorised redirect URIs:
#        http://localhost:3000/api/auth/callback/google
#        https://<your-vercel-domain>/api/auth/callback/google
#   5. Copy the client ID and client secret below.
#
# Never commit the real values — .env and .env*.local are gitignored.

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Session signing key. Generate one with:  npx auth secret
AUTH_SECRET=

# Only needed if the deployment URL is not auto-detected (Vercel sets this).
# AUTH_URL=https://your-domain.example/api/auth
